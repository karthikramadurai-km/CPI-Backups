<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="CEF">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="iFlowMessageId" type="xs:string" />
        <xs:element name="Event" type="xs:string" />
        <xs:element name="SourceIdentifier" type="xs:string" />
        <xs:element maxOccurs="unbounded" name="Transaction">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Status" type="xs:string" />
              <xs:element name="RequestPayload" />
              <xs:element name="Level" minOccurs="0" type="xs:string" />
              <xs:element name="ResponsePayload" minOccurs="0" />
              <xs:element name="Message" minOccurs="0" type="xs:string" />
              <xs:element name="Code" minOccurs="0" type="xs:string" />
              <xs:element name="OccurredAt" minOccurs="0" type="xs:string" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>