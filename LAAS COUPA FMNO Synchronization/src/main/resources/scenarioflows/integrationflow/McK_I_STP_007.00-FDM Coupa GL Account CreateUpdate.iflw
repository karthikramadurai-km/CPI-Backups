                <bpmn2:extensionElements>
                    <ifl:property>
                        <key>bodyType</key>
                        <value>expression</value>
                    </ifl:property>
                    <ifl:property>
                        <key>propertyTable</key>
                        <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;expression&lt;/cell&gt;&lt;cell id='Value'&gt;${exception.message}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;exceptionCheck&lt;/cell&gt;&lt;cell id='Datatype'&gt;String&lt;/cell&gt;&lt;/row&gt;</value>
                    </ifl:property>
                    <ifl:property>
                        <key>headerTable</key>
                        <value/>
                    </ifl:property>
                    <ifl:property>
                        <key>wrapContent</key>
                        <value>&lt;CEF&gt;
 &lt;iFlowMessageId&gt;${property.SAP_MessageProcessingLogID}&lt;/iFlowMessageId&gt;
   &lt;Event&gt;${camelId}&lt;/Event&gt;
   &lt;LogStart&gt;${date:exchangeCreated:yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}&lt;/LogStart&gt;
   &lt;LogEnd&gt;${date:now:yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}&lt;/LogEnd&gt;
    &lt;SourceIdentifier&gt;&lt;/SourceIdentifier&gt;
    &lt;Transaction&gt;
        &lt;Status&gt;ERROR&lt;/Status&gt;
        &lt;RequestPayload&gt;
            &lt;Data&gt;
                &lt;MessageId&gt;${header.SAP_MessageProcessingLogID}&lt;/MessageId&gt;
            &lt;/Data&gt;
        &lt;/RequestPayload&gt;
        &lt;Level&gt;Critical&lt;/Level&gt;
        &lt;Code&gt;500&lt;/Code&gt;
        &lt;MailSent&gt;Y&lt;/MailSent&gt;
        &lt;OccurredAt&gt;${date:now:yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}&lt;/OccurredAt&gt;
        &lt;ResponsePayload/&gt;
        &lt;Message&gt;${property.exceptionCheck}&lt;/Message&gt;
    &lt;/Transaction&gt;
&lt;/CEF&gt;</value>
                    </ifl:property>
                    <ifl:property>
                        <key>componentVersion</key>
